@startuml DER_Midas_API

!define ENTITY class
!define PK << (P,red) >>
!define FK << (F,blue) >>

ENTITY Account {
    PK id : BIGINT
    --
    nome : VARCHAR(100) NOT NULL
    saldo : DECIMAL(15,2) NOT NULL
}

ENTITY Transaction {
    PK id : BIGINT
    --
    valor : DECIMAL(15,2) NOT NULL
    data : TIMESTAMP NOT NULL
    tipo : VARCHAR(20) NOT NULL
    descricao : VARCHAR(500)
    FK account_id : BIGINT NOT NULL
}

Account ||--o{ Transaction : "possui"

note top of Transaction : "Tipos: RECEITA, DESPESA"
note bottom of Account : "Saldo deve ser >= 0"

@enduml
