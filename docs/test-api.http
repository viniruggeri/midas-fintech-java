@baseUrl = http://localhost:8080
@username = <seu_usuario>
@password = <sua_senha>

### Auth - Emitir Token
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
client.global.set("accessToken", response.body.token);
client.global.set("refreshToken", response.body.refreshToken);
client.test("Token emitido", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(!!response.body.token, "Missing access token");
  client.assert(!!response.body.refreshToken, "Missing refresh token");
});
%}

### Create Account
POST {{baseUrl}}/api/accounts
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nome": "Conta Principal",
  "saldo": 1000.00
}

> {% client.global.set("accountId", response.body.id); %}

### Get All Accounts
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}

> {% 
client.test("Accounts collection is HAL with _links and _embedded", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body._links && response.body._links.self && response.body._links.self.href, "Missing collection self link");
  client.assert(response.body._embedded && response.body._embedded.accountResponseDtoList, "Missing _embedded.accountResponseDtoList");
});
%}

### Get Account by ID
GET {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{accessToken}}

> {% 
client.test("Account has HATEOAS links", function() {
  const links = response.body._links;
  client.assert(!!links && !!links.self && !!links.self.href, "Missing self");
  client.assert(!!links && !!links["all-accounts"] && !!links["all-accounts"].href, "Missing all-accounts");
  client.assert(!!links && !!links.update && !!links.update.href, "Missing update");
  client.assert(!!links && !!links.delete && !!links.delete.href, "Missing delete");
  client.assert(!!links && !!links.transactions && !!links.transactions.href, "Missing transactions");
});
%}

### Update Account
PUT {{baseUrl}}/api/accounts/{{accountId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nome": "Conta Principal Atualizada",
  "saldo": 1500.00
}

### Create Transaction - Receita
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "valor": 500.00,
  "data": "2024-01-15T10:30:00",
  "tipo": "RECEITA",
  "descricao": "Salário mensal",
  "accountId": {{accountId}}
}

> {% client.global.set("transactionId1", response.body.id); %}

### Create Transaction - Despesa
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "valor": 150.00,
  "data": "2024-01-16T14:20:00",
  "tipo": "DESPESA",
  "descricao": "Compras no supermercado",
  "accountId": {{accountId}}
}

> {% client.global.set("transactionId2", response.body.id); %}

### Get All Transactions
GET {{baseUrl}}/api/transactions
Authorization: Bearer {{accessToken}}

> {% 
client.test("Transactions collection is HAL", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body._links && response.body._links.self && response.body._links.self.href, "Missing collection self link");
  client.assert(response.body._embedded, "Missing _embedded");
});
%}

### Get Transaction by ID
GET {{baseUrl}}/api/transactions/{{transactionId1}}
Authorization: Bearer {{accessToken}}

> {% 
client.test("Transaction has HATEOAS links", function() {
  const links = response.body._links;
  client.assert(!!links && !!links.self && !!links.self.href, "Missing self");
  client.assert(!!links && !!links["all-transactions"] && !!links["all-transactions"].href, "Missing all-transactions");
  client.assert(!!links && !!links.update && !!links.update.href, "Missing update");
  client.assert(!!links && !!links.delete && !!links.delete.href, "Missing delete");
  client.assert(!!links && !!links.account && !!links.account.href, "Missing account");
  client.assert(!!links && !!links["account-transactions"] && !!links["account-transactions"].href, "Missing account-transactions");
});
%}

### Get Transactions by Account ID
GET {{baseUrl}}/api/transactions/account/{{accountId}}
Authorization: Bearer {{accessToken}}

> {% 
client.test("Account transactions collection has links", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body._links && response.body._links.self && response.body._links.self.href, "Missing collection self link");
  client.assert(response.body._links && response.body._links.account && response.body._links.account.href, "Missing account link");
});
%}

### Get Transactions by Account ID (Paged)
GET {{baseUrl}}/api/transactions/account/{{accountId}}/paged?page=0&size=10&sort=data,desc
Authorization: Bearer {{accessToken}}

### Update Transaction
PUT {{baseUrl}}/api/transactions/{{transactionId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "valor": 600.00,
  "data": "2024-01-15T10:30:00",
  "tipo": "RECEITA",
  "descricao": "Salário mensal atualizado",
  "accountId": {{accountId}}
}

### Delete Transaction 1
DELETE {{baseUrl}}/api/transactions/{{transactionId1}}
Authorization: Bearer {{accessToken}}

### Delete Transaction 2
DELETE {{baseUrl}}/api/transactions/{{transactionId2}}
Authorization: Bearer {{accessToken}}

### Delete Account (after transactions)
DELETE {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{accessToken}}

### Auth - Refresh Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
client.global.set("accessToken", response.body.token);
client.global.set("refreshToken", response.body.refreshToken);
client.test("Refresh executado", function() {
  client.assert(response.status === 200, "Expected 200");
});
%}

### Auth - Logout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
